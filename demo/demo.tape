Output demo/demo.gif

Set Shell zsh
Set FontFamily "SauceCodePro Nerd Font Mono"
Set FontSize 16
Set Width 1200
Set Height 700
Set Theme GruvboxDark
Set Padding 12
Set Framerate 25
Set TypingSpeed 70ms

Hide
Type "demo/demo.sh"
Enter
Sleep 4s
Show
Sleep 1s

Type "j"
Sleep 1s
Type "j"
Sleep 1.5s
Enter
Sleep 2.5s
Escape
Sleep 500ms

Type "2"
Sleep 2s
Type "1"
Sleep 800ms

Type "s"
Sleep 1.5s
Type "tra"
Sleep 1.5s
Enter
Sleep 1s
Type "td3"
Sleep 400ms
Enter
Type "--time=00:20:00"
Sleep 400ms
Enter
Type "td3 try"
Sleep 600ms
Enter
Sleep 800ms
Type "y"
Sleep 4s

Type "p"
Sleep 4s
Type "C"
Sleep 2.5s
Type "y"
Sleep 3s

Type "?"
Sleep 3s
Escape
Sleep 500ms
Type "q"
Sleep 500ms
